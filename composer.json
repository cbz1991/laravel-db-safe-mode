{
    "name": "cabuz/laravel-db-safe-mode",
    "description": "Work with production data locally without fear: block outbound email, notifications, HTTP and queued side effects, make the connection read-only, and anonymize PII on the fly.",
    "keywords": ["laravel", "dev", "production", "safety", "readonly", "anonymize", "pii", "debugging"],
    "license": "MIT",
    "homepage": "https://github.com/cbz1991/laravel-db-safe-mode",
    "authors": [
        {
            "name": "Florin Cabuz",
            "email": "florin.cabuz@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/cbz1991/laravel-db-safe-mode/issues",
        "source": "https://github.com/cbz1991/laravel-db-safe-mode"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.5",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Required for the HTTP guard on Laravel 10 (bundled with Laravel 11+)."
    },
    "autoload": {
        "psr-4": {
            "Cabuz\\SafeMode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cabuz\\SafeMode\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cabuz\\SafeMode\\SafeModeServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
